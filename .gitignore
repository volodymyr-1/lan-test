# ── Виртуальные окружения ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Secrets & credentials (НИКОГДА не коммитить) ─────────────────────────────
.env
.env.*
!.env.example
secrets/
**/secrets/**
*.key
*.pem
*.p12
*token*
*secret*
*credential*
*api_key*

# ── Базы данных ───────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── ChromaDB паттерны ─────────────────────────────────────────────────────────
patterns/
**/patterns/chroma.sqlite3
**/patterns/*.bin

# ── Логи ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Тесты и coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
